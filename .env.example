# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string used by Prisma (see POSTGRES_* below for local docker-compose)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nema_db

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# URLs
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:4000

# Mail
MAIL_FROM=no-reply@example.com
MAIL_PROVIDER_API_KEY=

# Cloudinary (only needed if image upload via Cloudinary is enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used by docker-compose.yml to provision the local Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=nema_db
